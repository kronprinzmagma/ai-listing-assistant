# Copy this file to .env.local and replace each value with your actual credentials.
# NEVER commit .env.local — it is gitignored.

# Anthropic API key — required for all AI agents
# Obtain at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Ricardo.ch Partnership credentials — stub mode until SPIKE-01 resolved
RICARDO_PARTNERSHIP_KEY=your-partnership-key
RICARDO_PARTNERSHIP_PASSWORD=your-partnership-password
