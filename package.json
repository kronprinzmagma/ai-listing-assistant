{
  "name": "verkaufshilfe-via-foto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "tsx evals/run-eval.ts v1",
    "eval:v1": "tsx evals/run-eval.ts v1",
    "eval:v2": "tsx evals/run-eval.ts v2",
    "eval:v3": "tsx evals/run-eval.ts v3",
    "eval:price": "tsx evals/run-price-check.ts",
    "eval:injection": "PROMPTFOO_DISABLE_REMOTE_GENERATION=true PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 NODE_OPTIONS='--import tsx' promptfoo eval -c evals/redteam/promptfooconfig.yaml --no-cache --max-concurrency 2",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "secretlint --no-glob"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-anthropic": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "promptfoo": "^0.125.1",
    "secretlint": "^14.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "undici": "^7.29.0",
    "sharp": "^0.35.5",
    "adm-zip": "^0.6.1",
    "promptfoo": {
      "@hono/node-server": "^2.1.6",
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
