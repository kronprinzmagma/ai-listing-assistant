{
  "name": "@nilsseiter/ricardo-mcp",
  "version": "1.0.0",
  "description": "MCP server for Ricardo.ch listing management",
  "type": "module",
  "bin": {
    "ricardo-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.cjs",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "ricardo",
    "claude",
    "ai",
    "listing"
  ],
  "author": "nilsseiter",
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
